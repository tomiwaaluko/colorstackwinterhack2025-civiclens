# ============================================================================
# Frontend Environment Variables Template
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# Next.js automatically loads .env.local (it's gitignored for security).
#
# IMPORTANT: Replace placeholder values with your actual API keys and URLs.
# Do NOT commit .env.local to git (already in .gitignore).

# ----------------------------------------------------------------------------
# API Configuration
# ----------------------------------------------------------------------------
# Backend API base URL
# Default: http://localhost:8000 (used if not set)
# For production: Set to your backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# ----------------------------------------------------------------------------
# Demo/Offline Mode
# ----------------------------------------------------------------------------
# Set to "true" to enable demo mode (uses offline demo data, no API calls)
# Set to "false" or leave unset to connect to backend API
# Useful for: Development, demos, offline testing
NEXT_PUBLIC_DEMO_MODE=false

# ----------------------------------------------------------------------------
# Mapbox Configuration (Optional - for interactive maps)
# ----------------------------------------------------------------------------
# Mapbox access token for map visualizations
# Get your token from: https://account.mapbox.com/access-tokens/
# 
# If you don't have a Mapbox token, the app will use Leaflet (offline maps)
# Leaflet doesn't require an API key but has fewer features
#
# Format: pk.eyJ1IjoieW91cnVzZXJuYW1lIiwiYSI6ImNycXh4eHh4eDB4MDAycG84eHh4eHh4eHh4In0.your_token_here
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# ----------------------------------------------------------------------------
# Application Settings (Optional)
# ----------------------------------------------------------------------------
# App name for SEO and meta tags
# NEXT_PUBLIC_APP_NAME=CivicLens

# App description for SEO
# NEXT_PUBLIC_APP_DESCRIPTION=Transparent political data and visualizations

# ----------------------------------------------------------------------------
# Feature Flags (Optional)
# ----------------------------------------------------------------------------
# Enable/disable specific features
# NEXT_PUBLIC_ENABLE_AI_FEATURES=true
# NEXT_PUBLIC_ENABLE_VISUALIZATIONS=true
