# =============================================================================
# CivicLens Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control - it contains sensitive information

# =============================================================================
# DATABASE CONFIGURATION (Required)
# =============================================================================
# PostgreSQL database connection string
# Format: postgresql://user:password@host:port/database_name
# For Supabase: postgresql://postgres:[PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres
# For local PostgreSQL: postgresql://postgres:postgres@localhost:5432/civic_lens
DATABASE_URL=postgresql://user:password@localhost:5432/civic_lens

# =============================================================================
# GEMINI API CONFIGURATION (Required for RAG/AI features)
# =============================================================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model for text generation (optional, defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Gemini model for embeddings (optional, defaults to gemini-embedding-001)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# =============================================================================
# RAG CONFIGURATION (Optional - RAG/AI features)
# =============================================================================
# Number of top chunks to retrieve for RAG (optional, defaults to 8)
RAG_TOP_K=8

# Minimum similarity threshold for retrieved chunks (optional, defaults to 0.20)
# Similarity values below this threshold are treated as "no evidence"
RAG_MIN_SIMILARITY=0.20

# =============================================================================
# DATA INGESTION API KEYS (Optional - only needed for data ingestion scripts)
# =============================================================================

# Congress.gov API Key (Recommended - replacement for deprecated ProPublica)
# Get your API key from: https://api.congress.gov/
CONGRESS_GOV_API_KEY=your_congress_gov_api_key_here

# ProPublica API Key (DEPRECATED - API discontinued July 2024)
# Only needed if you have legacy data or are using the deprecated script
# Get your API key from: https://www.propublica.org/datastore/api/propublica-congress-api
# PROPUBLICA_API_KEY=your_propublica_api_key_here

# FEC API Key (Recommended - replacement for deprecated OpenSecrets)
# Get your API key from: https://api.open.fec.gov/developers/
# Note: OpenSecrets API was discontinued April 15, 2025
FEC_API_KEY=your_fec_api_key_here

# OpenSecrets API Key (DEPRECATED - API discontinued April 15, 2025)
# Only needed if you have legacy data or are using the deprecated script
# For alternatives, see: docs/opensecrets_alternatives.md
# OPENSECRETS_API_KEY=your_opensecrets_api_key_here

# OpenStates API Key (if using OpenStates data)
# Get your API key from: https://openstates.org/api/
OPENSTATES_API_KEY=your_openstates_api_key_here

# =============================================================================
# LOGGING CONFIGURATION (Optional)
# =============================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Defaults to INFO if not set
LOG_LEVEL=INFO

# =============================================================================
# APPLICATION CONFIGURATION (Optional)
# =============================================================================
# Enable demo mode (uses demo seed data instead of API calls)
# Set to 'true' or '1' to enable demo mode
# DEMO_MODE=false

# Environment: development, staging, production
# ENVIRONMENT=development

# =============================================================================
# CACHING CONFIGURATION (Optional - Future Enhancement)
# =============================================================================
# Redis URL for caching (NOT CURRENTLY IMPLEMENTED)
# Mentioned in documentation as future enhancement for caching search results
# Format: redis://localhost:6379 or redis://user:password@host:port
# REDIS_URL=redis://localhost:6379

# =============================================================================
# FRONTEND CONFIGURATION (Optional - for frontend/.env.local)
# =============================================================================
# Note: These variables should be set in frontend/.env.local, not backend/.env
# 
# Backend API URL (used by frontend/lib/api.ts)
# Defaults to http://localhost:8000 if not set
# NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Enable frontend demo mode (uses offline demo data, no API calls)
# Set to 'true' to enable demo mode in frontend
# NEXT_PUBLIC_DEMO_MODE=false
#
# Mapbox Access Token (NOT CURRENTLY USED - Mapbox not integrated)
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# =============================================================================
# NOTES
# =============================================================================
# 1. Minimum Required Variables:
#    - DATABASE_URL (required for all database operations)
#    - GEMINI_API_KEY (required for RAG/AI features)
#
# 2. Data Ingestion Variables:
#    - Only needed if running data ingestion scripts
#    - You can run the app with demo data without these keys
#
# 3. Database URL Formats:
#    - PostgreSQL (recommended): postgresql://user:pass@host:port/dbname
#    - For async operations, automatically converts to postgresql+asyncpg://
#
# 4. Getting API Keys:
#    - Gemini: https://makersuite.google.com/app/apikey
#    - Congress.gov: https://api.congress.gov/
#    - FEC (Federal Election Commission): https://api.open.fec.gov/developers/
#      Note: FEC API replaces deprecated OpenSecrets API (discontinued April 2025)
#    - OpenStates: https://openstates.org/api/
#    - OpenSecrets (DEPRECATED): See docs/opensecrets_alternatives.md
#
# 5. Currently Unused Variables:
#    - REDIS_URL: Mentioned in docs but NOT implemented (future caching)
#    - NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN: Mapbox not integrated
#
# 6. Frontend Variables:
#    - NEXT_PUBLIC_API_URL: Set in frontend/.env.local (defaults to localhost:8000)
#    - NEXT_PUBLIC_DEMO_MODE: Set in frontend/.env.local (for offline demo mode)
#
# 7. Security:
#    - Never commit .env file to version control
#    - Use .gitignore to exclude .env files
#    - Store production secrets in secure secret management systems
