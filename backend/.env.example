# =============================================================================
# CivicLens Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control - it contains sensitive information

# =============================================================================
# DATABASE CONFIGURATION (Required)
# =============================================================================
# PostgreSQL database connection string
# Format: postgresql://user:password@host:port/database_name
# For Supabase: postgresql://postgres:[PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres
# For local PostgreSQL: postgresql://postgres:postgres@localhost:5432/civic_lens
DATABASE_URL=postgresql://user:password@localhost:5432/civic_lens

# =============================================================================
# GEMINI API CONFIGURATION (Required for RAG/AI features)
# =============================================================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model for text generation (optional, defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Gemini model for embeddings (optional, defaults to gemini-embedding-001)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# =============================================================================
# RAG CONFIGURATION (Optional - RAG/AI features)
# =============================================================================
# Number of top chunks to retrieve for RAG (optional, defaults to 8)
RAG_TOP_K=8

# Minimum similarity threshold for retrieved chunks (optional, defaults to 0.20)
# Similarity values below this threshold are treated as "no evidence"
RAG_MIN_SIMILARITY=0.20

# =============================================================================
# DATA INGESTION API KEYS (Optional - only needed for data ingestion scripts)
# =============================================================================

# Congress.gov API Key (REQUIRED for federal legislators)
# Official API from the Library of Congress (replaces deprecated ProPublica API)
# Get your free API key from: https://api.congress.gov/sign-up/
CONGRESS_GOV_API_KEY=your_congress_gov_api_key_here

# OpenStates API Key (for state legislators - HIGHLY RECOMMENDED)
# Get your API key from: https://openstates.org/accounts/signup/
OPENSTATES_API_KEY=your_openstates_api_key_here

# OpenSecrets API Key (for campaign finance data)
# Get your API key from: https://www.opensecrets.org/open-data/api-documentation
OPENSECRETS_API_KEY=your_opensecrets_api_key_here

# Google Civic Information API (optional - for geocoding addresses)
# Get your API key from: https://console.cloud.google.com
# Enable the "Google Civic Information API" in your project
GOOGLE_CIVIC_API_KEY=your_google_api_key_here

# =============================================================================
# LOGGING CONFIGURATION (Optional)
# =============================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Defaults to INFO if not set
LOG_LEVEL=INFO

# =============================================================================
# APPLICATION CONFIGURATION (Optional)
# =============================================================================
# Enable demo mode (uses demo seed data instead of API calls)
# Set to 'true' or '1' to enable demo mode
# DEMO_MODE=false

# Environment: development, staging, production
# ENVIRONMENT=development

# =============================================================================
# NOTES
# =============================================================================
# 1. Minimum Required Variables:
#    - DATABASE_URL (required for all database operations)
#    - GEMINI_API_KEY (required for RAG/AI features)
#
# 2. Data Ingestion Variables:
#    - Only needed if running data ingestion scripts
#    - You can run the app with demo data without these keys
#
# 3. Database URL Formats:
#    - PostgreSQL (recommended): postgresql://user:pass@host:port/dbname
#    - For async operations, automatically converts to postgresql+asyncpg://
#
# 4. Getting API Keys:
#    - Gemini: https://makersuite.google.com/app/apikey
#    - Congress.gov: https://api.congress.gov/
#    - OpenSecrets: https://www.opensecrets.org/open-data/api-documentation
#    - OpenStates: https://openstates.org/api/
#
# 5. Security:
#    - Never commit .env file to version control
#    - Use .gitignore to exclude .env files
#    - Store production secrets in secure secret management systems
